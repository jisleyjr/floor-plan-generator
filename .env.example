# Placeholder values only. Copy to .env (gitignored) and replace them.
# The application reads process environment variables; it does not load this file.
# Example: set -a && source .env && set +a
#
# DATABASE_URL defaults, when unset, to an absolute SQLite file inside the
# runtime directory: sqlite:///<repository>/.runtime/floorplan.sqlite
DATABASE_URL=sqlite:///REPLACE_WITH_ABSOLUTE_PATH/floorplan.sqlite

# Default when unset: <repository>/.runtime  (relative values resolve from the repository root)
FLOORPLAN_DATA_DIR=.runtime

# Required to start the API. The worker and migrations do not need it.
FLOORPLAN_API_KEY=replace-with-a-long-random-string
